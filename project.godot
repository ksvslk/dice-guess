[input_devices]

pointing/emulate_touch_from_mouse=true

[locale]

translations=PoolStringArray( "res://translations/translations.en.translation", "res://translations/translations.et.translation", "res://translations/translations.ar.translation", "res://translations/translations.de.translation", "res://translations/translations.es.translation", "res://translations/translations.fi.translation", "res://translations/translations.fr.translation", "res://translations/translations.hi.translation", "res://translations/translations.id.translation", "res://translations/translations.it.translation", "res://translations/translations.ja.translation", "res://translations/translations.ko.translation", "res://translations/translations.ms.translation", "res://translations/translations.nb.translation", "res://translations/translations.pt.translation", "res://translations/translations.ru.translation", "res://translations/translations.th.translation", "res://translations/translations.tr.translation", "res://translations/translations.uk.translation", "res://translations/translations.vi.translation", "res://translations/translations.zh.translation", "res://translations/translations.sv.translation" )

[network]

limits/debugger_stdout/max_chars_per_second=10000
limits/debugger_stdout/max_messages_per_frame=100

[physics]

3d/smooth_trimesh_collision=true
common/enable_pause_aware_picking=true

[rendering]

vram_compression/import_etc=true
vram_compression/import_etc2=false
vram_compression/import_pvrtc=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
environment/default_environment="res://default_env.tres"
