; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Object",
"class": "Steam",
"language": "NativeScript",
"path": "res://addons/godotsteam/godotsteam.gdns"
} ]
_global_script_class_icons={
"Steam": ""
}

[application]

config/name="Dice Guess Steam"
run/main_scene="res://Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SaveDice"
boot_splash/image="res://icons/icon256.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )

[autoload]

C="*res://C.gd"
Data="*res://data.gd"
GPack="*res://GPack.gd"
Steam="*res://addons/godotsteam/steam.gd"

[display]

window/size/width=1920
window/size/height=1080
window/size/test_width=1920
window/size/test_height=1080
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray( "res://addons/godotsteam/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom_font="res://game_font.tres"

